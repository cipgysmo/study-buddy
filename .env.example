# --- LLM (your local rig) ---
# OpenAI-compatible endpoint served by llama-swap on the AI host
LLM_BASE_URL=http://192.168.1.136:8080/v1/
# Model id exposed by the router
LLM_MODEL=local-ai
# Optional; llama-swap ignores it, but some OpenAI-compatible servers require a value
# LLM_API_KEY=
# How long to wait/retry when the local LLM is busy or temporarily unavailable.
# LLM_BUSY_TIMEOUT_MS=600000
# In-process concurrency cap for LLM requests (llama-swap peaks at 2).
# LLM_MAX_CONCURRENCY=2
# Abort/retry a single upstream LLM request after this long.
# LLM_REQUEST_TIMEOUT_MS=360000

# --- App ---
# Port the server listens on inside the container (Docker maps host:container)
PORT=3000
# Where the SQLite DB + uploaded files live (mount a Docker volume here in production)
DATA_DIR=/app/data
# Maximum accepted material upload size in bytes.
MAX_UPLOAD_BYTES=1073741824
# Maximum accepted size for one chunked-upload request body.
MAX_UPLOAD_CHUNK_BYTES=8388608
# Maximum PDF pages to OCR. 0 means no limit.
PDF_OCR_MAX_PAGES=0
# Rendered PDF page width used for OCR.
PDF_OCR_PAGE_WIDTH=1600
# Optional LAN password gate. Leave empty to disable.
APP_PASSWORD=
# Optional build metadata shown in Settings. Docker builds set these automatically.
# APP_VERSION=0.1.0
# APP_COMMIT=
# APP_BUILD_DATE=
